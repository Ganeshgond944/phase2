"""
EyeMouse — Control your entire PC with your eyes.
- Gaze moves the mouse cursor across the full screen
- Blink (both eyes, hold 0.4s) = Left click
- Left-eye-only blink = Right click
- Right-eye-only blink = Double click
- Long blink (1.5s) = Scroll down
- Look at top-left corner for 1s = Open Start Menu

Run: py eye_mouse.py
Press Ctrl+C to stop.
"""

import os
os.environ["TF_ENABLE_ONEDNN_OPTS"] = "0"
os.environ["TF_CPP_MIN_LOG_LEVEL"] = "3"

import cv2
import numpy as np
import pyautogui
import time
import sys
import threading
from pathlib import Path
from collections import deque

sys.path.insert(0, str(Path(__file__).parent))
from backend.gaze_engine import GazeEngine

# ── Safety: pyautogui failsafe (move mouse to corner to stop) ─────────────────
pyautogui.FAILSAFE   = True   # move mouse to top-left corner to abort
pyautogui.PAUSE      = 0.0    # no delay between actions

SCREEN_W, SCREEN_H = pyautogui.size()
print(f"Screen: {SCREEN_W}x{SCREEN_H}")

# ── Config ────────────────────────────────────────────────────────────────────
SMOOTH_MOUSE   = 6      # mouse smoothing frames
CLICK_COOLDOWN = 0.8    # seconds between clicks
SCROLL_AMOUNT  = 3      # lines to scroll
CORNER_DWELL   = 1.2    # seconds to look at corner to trigger action

# ── State ─────────────────────────────────────────────────────────────────────
mouse_x_buf = deque(maxlen=SMOOTH_MOUSE)
mouse_y_buf = deque(maxlen=SMOOTH_MOUSE)
last_click  = 0.0
running     = True

# Corner zones (normalised 0-1): top-left, top-right, bottom-left, bottom-right
CORNERS = {
    "top-left":     (0.0, 0.0, 0.12, 0.12),
    "top-right":    (0.88, 0.0, 1.0, 0.12),
    "bottom-left":  (0.0, 0.88, 0.12, 1.0),
    "bottom-right": (0.88, 0.88, 1.0, 1.0),
}
corner_start = {}   # corner_name → time gaze entered


def in_corner(nx, ny, box):
    x1, y1, x2, y2 = box
    return x1 <= nx <= x2 and y1 <= ny <= y2


def handle_corner(corner_name, nx, ny):
    """Trigger action when gaze dwells in a corner."""
    global last_click
    now = time.time()
    if in_corner(nx, ny, CORNERS[corner_name]):
        if corner_name not in corner_start:
            corner_start[corner_name] = now
        elif now - corner_start[corner_name] >= CORNER_DWELL:
            corner_start.pop(corner_name)
            if corner_name == "top-left":
                print("Corner: Start Menu")
                pyautogui.hotkey("win")
            elif corner_name == "top-right":
                print("Corner: Task View")
                pyautogui.hotkey("win", "tab")
            elif corner_name == "bottom-left":
                print("Corner: Show Desktop")
                pyautogui.hotkey("win", "d")
            elif corner_name == "bottom-right":
                print("Corner: Action Center")
                pyautogui.hotkey("win", "a")
    else:
        corner_start.pop(corner_name, None)


def overlay_window():
    """Small always-on-top status window showing eye mouse status."""
    import tkinter as tk

    root = tk.Tk()
    root.title("EyeMouse")
    root.geometry("220x80+10+10")
    root.attributes("-topmost", True)
    root.attributes("-alpha", 0.85)
    root.configure(bg="#1a1d27")
    root.resizable(False, False)

    lbl_status = tk.Label(root, text="👁 EyeMouse Active",
                          fg="#00e5b0", bg="#1a1d27",
                          font=("Segoe UI", 10, "bold"))
    lbl_status.pack(pady=(10, 2))

    lbl_hint = tk.Label(root,
                        text="Blink=Click  L-eye=RClick  R-eye=DblClick\nMove to top-left corner to STOP",
                        fg="#8892a4", bg="#1a1d27",
                        font=("Segoe UI", 7),
                        justify="center")
    lbl_hint.pack()

    btn_stop = tk.Button(root, text="Stop EyeMouse",
                         command=lambda: stop_all(root),
                         bg="#ff4757", fg="white",
                         font=("Segoe UI", 8, "bold"),
                         relief="flat", padx=8, pady=3)
    btn_stop.pack(pady=4)

    root.mainloop()


def stop_all(root=None):
    global running
    running = False
    if root:
        root.destroy()
    print("\nEyeMouse stopped.")


def main():
    global running, last_click

    print("="*50)
    print("  👁 EyeMouse — Eye-Controlled PC Mouse")
    print("="*50)
    print("  Blink (hold 0.4s)  = Left click")
    print("  Left eye only      = Right click")
    print("  Right eye only     = Double click")
    print("  Long blink (1.5s)  = Scroll down")
    print("  Top-left corner    = Start Menu")
    print("  Top-right corner   = Task View")
    print("  Bottom-left corner = Show Desktop")
    print("  Move mouse to top-left = EMERGENCY STOP")
    print("="*50)
    print("Starting camera…\n")

    # Start overlay in separate thread
    overlay_thread = threading.Thread(target=overlay_window, daemon=True)
    overlay_thread.start()

    # Init gaze engine
    engine = GazeEngine(screen_w=SCREEN_W, screen_h=SCREEN_H)

    # Open webcam
    cap = None
    for backend in [cv2.CAP_DSHOW, cv2.CAP_MSMF, None]:
        try:
            c = cv2.VideoCapture(0, backend) if backend else cv2.VideoCapture(0)
            if c.isOpened():
                ret, _ = c.read()
                if ret:
                    cap = c
                    break
                c.release()
        except Exception:
            continue

    if cap is None:
        print("ERROR: Cannot open webcam!")
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_FPS, 30)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    print("Camera opened. EAR calibrating (keep eyes open for 2s)…")

    long_blink_start = None
    frame_count      = 0

    try:
        while running:
            ret, frame = cap.read()
            if not ret:
                time.sleep(0.01)
                continue

            frame = cv2.flip(frame, 1)
            result = engine.process_frame(frame)
            frame_count += 1

            if not result["face_detected"]:
                continue

            # ── Move mouse ────────────────────────────────────────────────────
            gx = result["gaze_x"]
            gy = result["gaze_y"]
            mouse_x_buf.append(gx)
            mouse_y_buf.append(gy)
            smooth_x = int(np.mean(mouse_x_buf))
            smooth_y = int(np.mean(mouse_y_buf))

            # Clamp to screen
            smooth_x = max(0, min(SCREEN_W - 1, smooth_x))
            smooth_y = max(0, min(SCREEN_H - 1, smooth_y))

            pyautogui.moveTo(smooth_x, smooth_y, _pause=False)

            # Normalised position for corner detection
            nx = smooth_x / SCREEN_W
            ny = smooth_y / SCREEN_H

            # ── Corner actions ────────────────────────────────────────────────
            for corner in CORNERS:
                handle_corner(corner, nx, ny)

            now = time.time()
            cool = now - last_click >= CLICK_COOLDOWN

            # ── Long blink → scroll down ──────────────────────────────────────
            if result["blink_probability"] > 0.75:
                if long_blink_start is None:
                    long_blink_start = now
                elif now - long_blink_start > 1.5 and cool:
                    pyautogui.scroll(-SCROLL_AMOUNT)
                    last_click = now
                    long_blink_start = None
                    print("Scroll down")
            else:
                long_blink_start = None

            # ── Both-eye blink → left click ───────────────────────────────────
            if result["blink"] and cool:
                pyautogui.click()
                last_click = now
                print(f"Left click @ ({smooth_x}, {smooth_y})")

            # ── Left-eye-only → right click ───────────────────────────────────
            elif result.get("left_blink") and cool:
                pyautogui.rightClick()
                last_click = now
                print(f"Right click @ ({smooth_x}, {smooth_y})")

            # ── Right-eye-only → double click ─────────────────────────────────
            elif result.get("right_blink") and cool:
                pyautogui.doubleClick()
                last_click = now
                print(f"Double click @ ({smooth_x}, {smooth_y})")

            # Print status every 60 frames
            if frame_count % 60 == 0 and engine._ear_ready:
                ear_avg = (result["left_ear"] + result["right_ear"]) / 2
                print(f"Gaze:({smooth_x},{smooth_y})  EAR:{ear_avg:.3f}  "
                      f"Blink%:{result['blink_probability']*100:.0f}%")

    except KeyboardInterrupt:
        print("\nStopped by user.")
    finally:
        cap.release()
        engine.release()
        print("EyeMouse closed.")


if __name__ == "__main__":
    main()
