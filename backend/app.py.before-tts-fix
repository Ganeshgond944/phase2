# ── Stream loop ───────────────────────────────────────────────────────────────
def stream_loop():
    global streaming, heatmap, fixation_log

    print("Opening webcam...")
    cap = None
    try:
        c = cv2.VideoCapture(0, cv2.CAP_DSHOW)

        if c.isOpened():
            c.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
            c.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
            c.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
            c.set(cv2.CAP_PROP_FPS, 30)
            c.set(cv2.CAP_PROP_BUFFERSIZE, 1)

            for _ in range(10):
                ret, frame = c.read()
                if ret and frame is not None and frame.size and float(frame.std()) > 5:
                    cap = c
                    print("Camera opened using MJPG.")
                    break

            if cap is None:
                c.release()
    except Exception as e:
        print("Camera error:", e)

    if cap is None:
        socketio.emit("error", {"message": "Cannot open webcam."})
        streaming = False
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_FPS, 30)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    socketio.emit("camera_ready", {})
    print("Streaming started.")

    frame_idx  = 0
    GAZE_EVERY = 1   # emit gaze every frame
    FRAME_EVERY= 6   # send camera image every 6 frames (~5fps) — reduces bandwidth
    TARGET_FPS = 30
    frame_time = 1.0 / TARGET_FPS

    while streaming:
        t0 = time.time()

        ret, frame = cap.read()
        if not ret:
            time.sleep(0.01)
            continue

        frame = cv2.flip(frame, 1)

        # Process gaze — fast (no CNN, just MediaPipe + EAR)
        try:
            result = engine.process_frame(frame)
        except Exception as e:
            result = {
                "gaze_x": SCREEN_W//2, "gaze_y": SCREEN_H//2,
                "blink": False, "blink_probability": 0.0,
                "face_detected": False, "left_ear": 1.0, "right_ear": 1.0,
                "pitch": 0.0, "yaw": 0.0,
            }

        # Heatmap
        hx = min(result["gaze_x"] * 192 // max(SCREEN_W,1), 191)
        hy = min(result["gaze_y"] * 108 // max(SCREEN_H,1), 107)
        heatmap[hy, hx] += 1.0

        # Fixation log
        fixation_log.append({
            "x": result["gaze_x"], "y": result["gaze_y"],
            "t": time.time(), "blink": result["blink"],
        })
        if len(fixation_log) > 300:
            fixation_log.pop(0)

        if result["blink"]:
            session_stats["blinks"] += 1

        # System mouse control (if enabled)
        if sys_ctrl.mouse_enabled:
            sys_ctrl.process_gesture(
                result["blink"],
                result.get("left_blink",  False),
                result.get("right_blink", False),
                result["gaze_x"], result["gaze_y"],
            )

        # Emit gaze every frame — lightweight dict, fast
        socketio.emit("gaze", {
            "x":           result["gaze_x"],
            "y":           result["gaze_y"],
            "blink":       result["blink"],
            "left_blink":  result.get("left_blink",  False),
            "right_blink": result.get("right_blink", False),
            "blink_prob":  round(result["blink_probability"], 2),
            "face":        result["face_detected"],
            "left_ear":    round(result["left_ear"],  3),
            "right_ear":   round(result["right_ear"], 3),
            "pitch":       round(result.get("pitch", 0.0), 3),
            "yaw":         round(result.get("yaw",   0.0), 3),
            "ear_ready":   engine._ear_ready,
        })

        # Send camera frame every 6 frames (5fps) — much less bandwidth
        if frame_idx % FRAME_EVERY == 0:
            disp = frame.copy()
            fx = int(result["gaze_x"] * disp.shape[1] / SCREEN_W)
            fy = int(result["gaze_y"] * disp.shape[0] / SCREEN_H)
            color = (0, 0, 255) if result["blink"] else (0, 255, 0)
            cv2.circle(disp, (fx, fy), 10, color, -1)
            cv2.circle(disp, (fx, fy), 13, (255,255,255), 2)
            if not result["face_detected"]:
                cv2.putText(disp, "No face", (10,35),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0,165,255), 2)
            if result["blink"]:
                cv2.putText(disp, "BLINK", (10,35),
                            cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0,0,255), 2)
            ear_avg = (result["left_ear"] + result["right_ear"]) / 2
            cv2.putText(disp, f"EAR:{ear_avg:.2f}", (10, disp.shape[0]-8),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0,255,100), 1)
            # Low quality JPEG = small payload = fast transfer
            ok, buf = cv2.imencode(".jpg", disp, [cv2.IMWRITE_JPEG_QUALITY, 55])
            if ok:
                socketio.emit("frame", {"data": base64.b64encode(buf).decode()})

        frame_idx += 1

        # Precise FPS throttle
        elapsed = time.time() - t0
        sleep_t = frame_time - elapsed
        if sleep_t > 0:
            time.sleep(sleep_t)

    cap.release()
    print("Webcam released.")
    socketio.emit("camera_stopped", {})


# ── API ───────────────────────────────────────────────────────────────────────
@app.route("/api/start", methods=["POST"])
def start_stream():
    global streaming
    with stream_lock:
        if streaming:
            return jsonify({"status": "already_running"})
        streaming = True
        threading.Thread(target=stream_loop, daemon=True).start()
    return jsonify({"status": "started"})


@app.route("/api/stop", methods=["POST"])
def stop_stream():
    global streaming
    streaming = False
    return jsonify({"status": "stopped"})


@app.route("/api/status", methods=["GET"])
def get_status():
    return jsonify({
        "streaming":  streaming,
        "calibrated": engine.is_calibrated if engine else False,
    })


@app.route("/api/predict", methods=["POST"])
def predict_words():
    data = request.json or {}
    text = data.get("text", "")
    current = get_current_word(text)
    suggestions = get_predictions(current, n=3)
    return jsonify({"suggestions": suggestions, "current_word": current})


@app.route("/api/speak", methods=["POST"])
def speak_text():
    data = request.json or {}
    text = data.get("text", "").strip()
    if not text:
        return jsonify({"status": "empty"})

    def _speak():
        global tts_engine
        with tts_lock:
            try:
                import pyttsx3
                if tts_engine is None:
                    tts_engine = pyttsx3.init()
                    tts_engine.setProperty("rate", 150)
                tts_engine.say(text)
                tts_engine.runAndWait()
            except Exception as e:
                print(f"TTS error: {e}")

    threading.Thread(target=_speak, daemon=True).start()
    return jsonify({"status": "speaking"})


@app.route("/api/stats", methods=["GET"])
def get_stats():
    elapsed = time.time() - session_stats["start_time"]
    wpm = session_stats["words"] / max(elapsed/60, 0.01)
    return jsonify({
        "keys_typed": session_stats["keys_typed"],
        "blinks":     session_stats["blinks"],
        "words":      session_stats["words"],
        "wpm":        round(wpm, 1),
    })


@app.route("/api/stats/key", methods=["POST"])
def record_key():
    data = request.json or {}
    session_stats["keys_typed"] += 1
