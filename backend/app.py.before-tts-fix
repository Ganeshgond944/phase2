# ── Eye Mouse ─────────────────────────────────────────────────────────────────
_eye_mouse_proc = None

@app.route("/api/eye_mouse/start", methods=["POST"])
def start_eye_mouse():
    global _eye_mouse_proc
    import subprocess, sys
    if _eye_mouse_proc and _eye_mouse_proc.poll() is None:
        return jsonify({"status": "already_running"})
    script = Path(__file__).parent.parent / "eye_mouse.py"
    _eye_mouse_proc = subprocess.Popen(
        [sys.executable, str(script)],
        creationflags=0x00000010  # CREATE_NEW_CONSOLE on Windows
    )
    return jsonify({"status": "started", "pid": _eye_mouse_proc.pid})


@app.route("/api/eye_mouse/stop", methods=["POST"])
def stop_eye_mouse():
    global _eye_mouse_proc
    if _eye_mouse_proc and _eye_mouse_proc.poll() is None:
        _eye_mouse_proc.terminate()
        return jsonify({"status": "stopped"})
    return jsonify({"status": "not_running"})


@app.route("/api/blink_threshold", methods=["POST"])
def set_blink_threshold():
    data = request.json
    if engine:
        engine.BLINK_DURATION = float(data.get("duration",      0.35))
        engine.EAR_THRESHOLD  = float(data.get("ear_threshold", 0.25))
        engine.BLINK_COOLDOWN = float(data.get("cooldown",      0.50))
    return jsonify({"status": "ok"})


# ── Save text to file ─────────────────────────────────────────────────────────
@app.route("/api/save_text", methods=["POST"])
def save_text():
    data = request.json or {}
    text = data.get("text", "").strip()
    if not text:
        return jsonify({"status": "empty"})
    try:
        import datetime
        desktop = Path.home() / "Desktop"
        desktop.mkdir(exist_ok=True)
        ts       = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filepath = desktop / f"eyetype_{ts}.txt"
        filepath.write_text(text, encoding="utf-8")
        return jsonify({"status": "saved", "path": str(filepath)})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})


