def _load_phrases():
    if PHRASES_FILE.exists():
        try:
            return json.loads(PHRASES_FILE.read_text())
        except Exception:
            pass
    return DEFAULT_PHRASES


def _save_phrases(phrases):
    PHRASES_FILE.write_text(json.dumps(phrases, indent=2))


@app.route("/api/phrases", methods=["GET"])
def get_phrases():
    return jsonify({"phrases": _load_phrases()})


@app.route("/api/phrases", methods=["POST"])
def save_phrases():
    data = request.json or {}
    phrases = data.get("phrases", [])
    _save_phrases(phrases)
    return jsonify({"status": "saved"})


def _save_calibration():
    try:
        if engine.cal_transform is not None:
            CALIBRATION_FILE.write_text(json.dumps({
                "transform": engine.cal_transform.tolist(),
                "points":    engine.calibration_points,
                "gaze":      engine.calibration_gaze,
            }))
    except Exception as e:
        print(f"Save cal error: {e}")


