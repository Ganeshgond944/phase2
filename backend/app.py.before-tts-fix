@app.route("/api/system/window/<action>", methods=["POST"])
def window_action(action):
    actions = {
        "minimize": sys_ctrl.minimize_active_window,
        "maximize": sys_ctrl.maximize_active_window,
        "close":    sys_ctrl.close_active_window,
        "switch":   sys_ctrl.switch_window,
        "desktop":  sys_ctrl.show_desktop,
    }
    fn = actions.get(action)
    if fn:
        fn()
        return jsonify({"status": "ok", "action": action})
    return jsonify({"status": "unknown_action"}), 400


